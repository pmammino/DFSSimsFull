# Copy to .streamlit/secrets.toml (locally) or paste into the Streamlit Cloud
# app's Settings → Secrets. When present, the app shares the refreshed
# sims/projections across all users via this S3 bucket and survives restarts.
# Omit this section entirely to run purely on the local filesystem.

[shared_store]
bucket = "your-dfs-bucket"
prefix = "dfs"                       # optional key prefix within the bucket
region = "us-east-1"                 # optional
# endpoint_url = "https://<acct>.r2.cloudflarestorage.com"  # optional: R2/MinIO/B2
access_key_id = "AKIA..."            # optional if the host provides an IAM role
secret_access_key = "..."            # optional
